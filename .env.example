# ===== Django 기본 설정 =====
# 프로덕션에서는 반드시 강력한 SECRET_KEY를 생성하세요
# 생성 방법: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here

# 개발 환경에서만 True, 프로덕션에서는 반드시 False
DEBUG=False

# 허용할 호스트 (쉼표로 구분, 공백 없이) — 서버 공인 IP 도 포함 (IP 로 검증할 때 필요)
# 예: DJANGO_ALLOWED_HOSTS=techchang.com,www.techchang.com,161.118.232.178
DJANGO_ALLOWED_HOSTS=techchang.com,www.techchang.com,161.118.232.178

# 관리자 URL prefix (prod.py, 기본 secret-control-panel/)
# DJANGO_ADMIN_URL=secret-control-panel/

# HTTPS 리다이렉트 (prod.py, 기본 true). 새 서버에서 인증서 적용 전 IP 검증 시에만 false — 검증 후 즉시 제거
# DJANGO_SECURE_SSL_REDIRECT=false

# ===== 데이터베이스 (config/settings/base.py) =====
# 미설정 시 SQLite(db.sqlite3). 운영 서버는 MySQL — 아래 5개 모두 필요
# MySQL 사용 시 서버에 mysqlclient 필요: pip install -r requirements-prod.txt
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=techchang
DJANGO_DB_USER=techchang
DJANGO_DB_PASSWORD=your-db-password-here
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306

# ===== API 키 설정 =====
# Anthropic Claude API 키 (칼럼 자동 작성 등 AI 기능 사용 시)
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 카카오 로그인 API 설정
# 발급: https://developers.kakao.com/
KAKAO_REST_API_KEY=your-kakao-rest-api-key-here
KAKAO_CLIENT_SECRET=your-kakao-client-secret-here

# 국립국어원 한국어기초사전 API 키 (끝말잇기 게임용, 선택사항)
# 발급: https://krdict.korean.go.kr/openApi/openApiRegister
KOREAN_DICT_API_KEY=your-korean-dict-api-key-here

# AI 로그 지적사항 → 자동 수정 PR (선택). fine-grained PAT (Contents read/write)
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=inucreativehrd21/TechChang

# Google Search Console (방문자 리포트, 선택). 둘 중 하나. token.json 은 절대경로로
# GSC_OAUTH_TOKEN=/home/ubuntu/projects/mysite/token.json
# GSC_CREDENTIALS_JSON=
# GSC_SITE_URL=sc-domain:techchang.com

# ===== 게임 설정 =====
WORDCHAIN_TIMEOUT=30
WORDCHAIN_USE_DICTIONARY_API=True

# ===== 보안 미들웨어 설정 =====
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=3600
DDOS_THRESHOLD=120
BLOCK_DURATION=180
SUSPICION_SCORE_THRESHOLD=20
PROTECTED_PATH_ATTEMPTS_LIMIT=50

# ===== 이메일 설정 (선택사항) =====
# Gmail SMTP 사용 예시
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your-email@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=your-app-password
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false
# DJANGO_EMAIL_TIMEOUT=30
# DJANGO_DEFAULT_FROM_EMAIL=noreply@techchang.com
# DJANGO_ADMIN_EMAIL=admin@techchang.com
